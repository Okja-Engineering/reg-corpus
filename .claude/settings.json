{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/registry/**)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/**)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(regcorpus verify *)",
      "Bash(./regcorpus verify *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/r11-guard.sh"
          }
        ]
      }
    ]
  }
}
