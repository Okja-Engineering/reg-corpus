#!/usr/bin/env bash
# Per-commit corpus gate (C6, R5). Installed by `make setup` (core.hooksPath).
#
# Checks the commit, not a copy of it: `git write-tree` turns the index being
# committed into a tree, and `regcorpus check --corpus --tree` reads its raw
# blobs. So skip-worktree and sparse entries are checked, filters and
# end-of-line conversion don't change the hashed bytes, symlinks are never
# followed, and intent-to-add entries (not in the tree) don't block.
#
# The checker is built from main (refs/heads/main, which a person moves),
# never from the branch being committed. So no branch can weaken the code that
# checks it: not by committing a weaker checker first, --amend, an orphan
# branch or a moved cmd/regcorpus/main.go. And a branch whose own checker
# doesn't build can still commit. Only while main holds no checker (no
# cmd/regcorpus/main.go: until PR #1 merges) or doesn't exist yet (a fresh
# repo) is it built from the tree being committed. Its source (go.mod, go.sum
# when present, cmd/, internal/) is copied as raw blobs, the way the check
# reads the commit (ls-tree, cat-file, no replace refs), so no filter or
# replace ref can change it. Go settings that could swap it (GOFLAGS, a go env
# file, go.work, a toolchain switch) are turned off for the build, and a built
# binary runs, so its exit code reaches this script. Any failure blocks.
#
# Trade-off: a branch that changes what C6 reads (e.g. the verify.log format,
# plan step 19) is checked by main's older checker until it merges, so it may
# have to land in two steps: the checker first, then the data it reads.
#
# Residual (CI later): the index can change between write-tree and the commit;
# commits that skip pre-commit (merge, rebase, cherry-pick, am, commit-tree)
# are not checked here; whoever moves or deletes the local main ref, or
# changes the Go toolchain, chooses the checker.
set -euo pipefail
export GIT_NO_REPLACE_OBJECTS=1

fail() {
  echo "pre-commit: C6 gate failed${1:+ ($1)}" >&2
  exit 1
}

tree=$(git write-tree) || fail "git write-tree"
src=$tree
if main=$(git rev-parse -q --verify 'refs/heads/main^{commit}') &&
  git cat-file -e "$main:cmd/regcorpus/main.go" 2>/dev/null; then
  src=$main
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/regcorpus-pre-commit.XXXXXX") || fail "mktemp"
trap 'rm -rf "$tmp"' EXIT
git ls-tree -r -z --full-tree "$src" -- go.mod go.sum cmd internal >"$tmp/files" ||
  fail "listing the checker in $src"
while IFS= read -r -d '' entry; do # "<mode> blob <oid>\t<path>"
  meta=${entry%%$'\t'*} path=${entry#*$'\t'}
  case $meta in
  '100644 blob '* | '100755 blob '*) ;;
  *) fail "checker file $path in $src is not a regular file" ;;
  esac
  case $path in */*) mkdir -p "$tmp/src/${path%/*}" ;; esac
  git cat-file blob "${meta##* }" >"$tmp/src/$path" || fail "reading $path from $src"
done <"$tmp/files"
[ -f "$tmp/src/go.mod" ] || fail "no go.mod in $src"
(cd "$tmp/src" && env GOENV=off GOFLAGS= GOWORK=off GOTOOLCHAIN=local \
  go build -o "$tmp/regcorpus" ./cmd/regcorpus) || fail "building the checker from $src"
"$tmp/regcorpus" check --corpus --tree "$tree" || fail
